<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd: Linkten Haber İncele izleyicisini SÜREKLI çalıştırır (KeepAlive).
  WP admin'de yapıştırılan işler otomatik işlenir.
  Kurulum:
    cp com.haberler.incele.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.haberler.incele.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.haberler.incele</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/apple/Haberler/n8n/scheduler/run-incele.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/apple/Haberler/n8n/scheduler/incele.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/apple/Haberler/n8n/scheduler/incele.launchd.err.log</string>
</dict>
</plist>
